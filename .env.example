# Скопируй в .env и поправь под себя: cp .env.example .env

# Единственное постоянное хранилище задач. Это не каталог клона репозитория.
DASHBOARD_DATA_DIR=C:/Main/crystal_wave/Data/personal-dashboard

# Двусторонняя синхронизация с V2. Один и тот же случайный ключ указывается в обоих .env.
V2_PEER_URL=http://host.docker.internal:8090
V1_V2_SYNC_KEY=

# Локальная Ollama (по умолчанию — хост, на котором крутится Docker)
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
# Запасная модель чата по задачам и базе знаний; Gemma 4 вызывается с think=false
OLLAMA_CHAT_MODEL=gemma4:e4b-it-qat

# DeepSeek через OpenRouter — основной провайдер; Ollama остаётся запасным
OPENROUTER_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
# Docker reads the key from C:/Main/crystal_wave/Secrets/open-router-api-key-vs-code.txt.
# Keep API keys out of this file and out of Git.
